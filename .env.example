CHUNKFORGE_ENVIRONMENT=local
CHUNKFORGE_LOG_LEVEL=INFO
CHUNKFORGE_POSTGRES_DSN=postgresql://chunkforge:chunkforge@localhost:5432/chunkforge
CHUNKFORGE_REDIS_URL=redis://localhost:6379/0
CHUNKFORGE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CHUNKFORGE_OLLAMA_BASE_URL=http://localhost:11434
CHUNKFORGE_OLLAMA_MODEL=llama3.2:1b
CHUNKFORGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNKFORGE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CHUNKFORGE_RAW_DATA_DIR=data/raw
CHUNKFORGE_PROCESSED_DATA_DIR=data/processed
CHUNKFORGE_TOKEN_ENCODING=cl100k_base
CHUNKFORGE_CHUNK_SIZE=512
CHUNKFORGE_CHUNK_OVERLAP=50
CHUNKFORGE_SEMANTIC_THRESHOLD=0.5
CHUNKFORGE_SENTENCE_WINDOW_SIZE=1
CHUNKFORGE_LATE_CHUNK_SIZE=128
CHUNKFORGE_EMBEDDING_BATCH_SIZE=32
CHUNKFORGE_EMBEDDING_DEVICE=cpu
CHUNKFORGE_EMBEDDING_DIMENSIONS=384
CHUNKFORGE_VECTOR_TABLE=chunkforge_chunks
CHUNKFORGE_HNSW_EF_SEARCH=100
CHUNKFORGE_EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
CHUNKFORGE_RETRIEVAL_CANDIDATES=50
CHUNKFORGE_RERANK_CANDIDATES=20
CHUNKFORGE_RETRIEVAL_LIMIT=5
CHUNKFORGE_RRF_K=60
CHUNKFORGE_CACHE_TTL_SECONDS=86400
CHUNKFORGE_REDIS_TIMEOUT_SECONDS=0.25
CHUNKFORGE_RETRY_ATTEMPTS=3
CHUNKFORGE_RETRY_BASE_DELAY=0.1
CHUNKFORGE_RETRY_MAX_DELAY=1.0
CHUNKFORGE_BREAKER_FAILURE_THRESHOLD=3
CHUNKFORGE_BREAKER_RECOVERY_SECONDS=30
CHUNKFORGE_GENERATION_CONTEXT_SIZE=2048
CHUNKFORGE_GENERATION_OUTPUT_TOKENS=192
CHUNKFORGE_GENERATION_SOURCE_BYTES=700
CHUNKFORGE_GENERATION_TIMEOUT_SECONDS=180
CHUNKFORGE_GENERATION_THREADS=2
CHUNKFORGE_CORS_ORIGINS=["http://localhost:4200"]
CHUNKFORGE_KAFKA_INGESTION_TOPIC=chunkforge.ingestion
CHUNKFORGE_KAFKA_DLQ_TOPIC=chunkforge.ingestion.dlq
CHUNKFORGE_KAFKA_GROUP_ID=chunkforge-indexers

