CHUNKFORGE_ENVIRONMENT=local
CHUNKFORGE_LOG_LEVEL=INFO
CHUNKFORGE_POSTGRES_DSN=postgresql://chunkforge:chunkforge@localhost:5432/chunkforge
CHUNKFORGE_REDIS_URL=redis://localhost:6379/0
CHUNKFORGE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CHUNKFORGE_OLLAMA_BASE_URL=http://localhost:11434
CHUNKFORGE_OLLAMA_MODEL=llama3.1
CHUNKFORGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNKFORGE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNKFORGE_RAW_DATA_DIR=data/raw
CHUNKFORGE_PROCESSED_DATA_DIR=data/processed
CHUNKFORGE_TOKEN_ENCODING=cl100k_base
CHUNKFORGE_CHUNK_SIZE=512
CHUNKFORGE_CHUNK_OVERLAP=50
CHUNKFORGE_SEMANTIC_THRESHOLD=0.5
CHUNKFORGE_SENTENCE_WINDOW_SIZE=1
CHUNKFORGE_LATE_CHUNK_SIZE=128
CHUNKFORGE_EMBEDDING_BATCH_SIZE=32
CHUNKFORGE_EMBEDDING_DEVICE=cpu

